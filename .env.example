APP_NAME="Kalinga CEFMU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
REGISTRATION_ENABLED=true
UAT_ENABLED=false
# Production: set REGISTRATION_ENABLED=false (open registration is disabled in render.yaml)

# Google OAuth is optional. The URI must exactly match an Authorized redirect URI
# in the Google Cloud OAuth client (including scheme, host, port, and path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kalinga_is
DB_USERNAME=postgres
DB_PASSWORD=
# Supabase (production): set DB_URL to the Session pooler string from
# Connect in the Supabase dashboard, for example
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-ap-southeast-1.pooler.supabase.com:5432/postgres
# and DB_SSLMODE=require. DB_URL overrides the DB_HOST/PORT/DATABASE/USERNAME values.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/path/to/supabase-root.crt   (with DB_SSLMODE=verify-full)
# Only for the transaction pooler (port 6543):
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production: set SESSION_SECURE_COOKIE=true (default when env var is unset)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Uploaded files remain quarantined unless an approved scanner clears them.
SCAN_DRIVER=none
CLAMAV_BINARY=clamscan
SCAN_TIMEOUT_SECONDS=120

# Production-only. Leave blank locally; set these as Render secrets.
PROVISION_ADMIN_NAME=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Behind a proxy or load balancer (Render, Nginx, cloud LB): its IPs, comma-separated, or *
TRUSTED_PROXIES=

# Roles that must use a second factor (email code or authenticator app)
MFA_ROLES=system_admin,social_worker,fo_user,cpu_member
