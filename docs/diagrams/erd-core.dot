// Core entity relationship diagram (generated from the PostgreSQL foreign keys). Links to users (created_by, assigned_to and similar) are left out for readability.
// Render: dot -Tpng -Gdpi=110 erd-core.dot -o erd-core.png
digraph erd {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=1.2, pad=0.3, splines=true];
  node [shape=box, style="rounded,filled", fillcolor="#f4f1fa", color="#5b21b6", fontname="Helvetica", fontsize=10];
  edge [color="#8b84a3", arrowhead=crow, arrowtail=none, dir=forward, fontname="Helvetica", fontsize=7, fontcolor="#5b5670"];
  case_aftercare_plans [label="case_aftercare_plans"];
  case_assessment_sections [label="case_assessment_sections"];
  case_assessments [label="case_assessments"];
  case_closure_records [label="case_closure_records"];
  case_conferences [label="case_conferences"];
  case_notes [label="case_notes"];
  case_plan_goals [label="case_plan_goals"];
  case_plan_reviews [label="case_plan_reviews"];
  case_plans [label="case_plans"];
  cases [label="cases", fillcolor="#5b21b6", fontcolor="white"];
  child_participation_records [label="child_participation_records"];
  clients [label="clients", fillcolor="#5b21b6", fontcolor="white"];
  consents [label="consents"];
  documents [label="documents"];
  interventions [label="interventions"];
  lgu_cpu_members [label="lgu_cpu_members"];
  lgu_profiles [label="lgu_profiles"];
  lgu_units [label="lgu_units"];
  mdt_case_access [label="mdt_case_access"];
  mdt_case_notes [label="mdt_case_notes"];
  monitoring_visits [label="monitoring_visits"];
  referral_events [label="referral_events"];
  referrals [label="referrals"];
  relationships [label="relationships"];
  reports [label="reports"];
  risk_assessments [label="risk_assessments"];
  service_providers [label="service_providers"];
  services_provided [label="services_provided"];
  tasks [label="tasks"];
  user_lgu_assignments [label="user_lgu_assignments"];
  cases -> case_aftercare_plans [label="case_id"];
  case_plans -> case_aftercare_plans [label="case_plan_id"];
  case_assessments -> case_assessment_sections [label="case_assessment_id"];
  cases -> case_assessments [label="case_id"];
  cases -> case_closure_records [label="case_id"];
  cases -> case_conferences [label="case_id"];
  child_participation_records -> case_conferences [label="child_participation_record_id"];
  risk_assessments -> case_conferences [label="risk_assessment_id"];
  cases -> case_notes [label="case_id"];
  case_plans -> case_plan_goals [label="case_plan_id"];
  case_plans -> case_plan_reviews [label="case_plan_id"];
  cases -> case_plans [label="case_id"];
  child_participation_records -> case_plans [label="child_participation_record_id"];
  case_assessments -> case_plans [label="comprehensive_assessment_id"];
  risk_assessments -> case_plans [label="risk_assessment_id"];
  clients -> cases [label="client_id"];
  lgu_units -> cases [label="lgu_id"];
  reports -> cases [label="report_id"];
  cases -> child_participation_records [label="case_id"];
  cases -> consents [label="case_id"];
  cases -> documents [label="case_id"];
  case_plan_goals -> interventions [label="case_plan_goal_id"];
  case_plans -> interventions [label="case_plan_id"];
  service_providers -> interventions [label="service_provider_id"];
  lgu_units -> lgu_cpu_members [label="lgu_id"];
  lgu_units -> lgu_profiles [label="lgu_id"];
  cases -> mdt_case_access [label="case_id"];
  cases -> mdt_case_notes [label="case_id"];
  mdt_case_access -> mdt_case_notes [label="mdt_access_id"];
  cases -> monitoring_visits [label="case_id"];
  referrals -> referral_events [label="referral_id"];
  cases -> referrals [label="case_id"];
  case_notes -> referrals [label="case_note_id"];
  lgu_cpu_members -> referrals [label="lgu_cpu_member_id"];
  mdt_case_access -> referrals [label="mdt_case_access_id"];
  service_providers -> referrals [label="service_provider_id"];
  clients -> relationships [label="client_id"];
  clients -> reports [label="client_id"];
  lgu_units -> reports [label="lgu_id"];
  cases -> risk_assessments [label="case_id"];
  cases -> services_provided [label="case_id"];
  case_notes -> services_provided [label="case_note_id"];
  referrals -> services_provided [label="referral_id"];
  cases -> tasks [label="case_id"];
  lgu_units -> user_lgu_assignments [label="lgu_id"];
}
