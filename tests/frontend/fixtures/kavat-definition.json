                "Maayos ang pag-iisip, matatag sa emosyon, at may positibong pananaw sa hinaharap."
            ],
            "statements": [
                {
                    "number": 24,
                    "text": "Madalas akong nakakaramdam ng takot, matinding pag-aalala, lungkot, o pagkalito tungkol sa aking kasalukuyang sitwasyon at kinabukasan.",
                    "reversed": true
                },
                {
                    "number": 25,
