                "Malakas ang suporta mula sa pamilya at komunidad."
            ],
            "statements": [
                {
                    "number": 21,
                    "text": "May mga miyembro ng aking pamilya o ibang taong malapit sa akin na sumusuporta at gumagalang sa aking mga desisyon at kapakanan.",
                    "reversed": false
                },
                {
                    "number": 22,
                    "text": "Hindi ako nakakaranas ng panghuhusga, paninisi, diskriminasyon, o negatibong pagtrato dahil sa aking relasyon, pagsasama, o sitwasyon.",
                    "reversed": true
                },
                {
                    "number": 23,
                    "text": "May access ako sa mga serbisyo at programa sa aking komunidad na maaaring makatulong sa aking sitwasyon.",
                    "reversed": false
                }
            ]
        },
