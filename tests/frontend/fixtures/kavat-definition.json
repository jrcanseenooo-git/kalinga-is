    "domains": [
        {
            "code": "I",
            "title": "Child's Rights, Legal Awareness, and Empowerment",
            "items": [
                1,
                2,
                3,
                4
            ],
            "bands": [
                12,
                16
            ],
            "interpretations": [
                "Limitado ang kaalaman, posibleng vulnerable sa abuse o exploitation.",
                "May kaalaman ngunit kailangan pa ng pagpapalakas.",
                "Malinaw na nauunawaan at naipapakita ang empowerment at karapatan."
            ],
            "statements": [
                {
                    "number": 1,
                    "text": "Kaya kong ipaliwanag ang aking mga karapatan bilang isang bata, kabilang ang aking karapatang maging ligtas mula sa child, early and forced marriage\/union.",
                    "reversed": false
                },
                {
                    "number": 2,
                    "text": "Alam ko na may mga batas at polisiya na nagpoprotekta sa mga bata laban sa child, early and forced marriage\/union at iba pang uri ng pang-aabuso o pagsasamantala.",
                    "reversed": false
                },
                {
                    "number": 3,
                    "text": "Alam ko kung saan at kanino ako maaaring lumapit kung may lumalabag sa aking mga karapatan o kung hindi ako ligtas.",
                    "reversed": false
                },
                {
                    "number": 4,
                    "text": "Pakiramdam ko ay wala akong kakayahan na magsabi ng aking saloobin at gumawa ng mga desisyon tungkol sa mga bagay na may epekto sa aking buhay.",
                    "reversed": true
                }
            ]
        },
        {
            "code": "II",
            "title": "Safety, Protection, and Freedom from Violence",
            "items": [
                5,
                6,
                7,
                8
            ],
            "bands": [
                12,
                16
            ],
            "interpretations": [
                "Kinakailangan ng masinsinang counseling at guidance \/ mataas ang panganib.",
                "May kaalaman ngunit kailangan pa ng dagdag na suporta.",
                "Malinaw ang kaalaman at kakayahan sa pag-iwas at paghingi ng proteksyon."
            ],
            "statements": [
                {
                    "number": 5,
                    "text": "Nakakaramdam ako na hindi ligtas sa aking tahanan, sa aking relasyon o pagsasama, at sa aking komunidad.",
                    "reversed": true
                },
                {
                    "number": 6,
                    "text": "Ako ay may ganap na kalayaan at kontrol sa aking mga desisyon, nang walang anumang pamimilit, pagbabanta, o pagtatangkang kumontrol mula sa ibang tao.",
                    "reversed": false
                },
                {
                    "number": 7,
                    "text": "Kapag may hindi magandang nangyayari sa akin, may isang taong mapagkakatiwalaan kong malalapitan para sa tulong at proteksyon.",
                    "reversed": false
                },
                {
                    "number": 8,
                    "text": "Alam ko kung paano humingi ng tulong kung ako ay nakaranas o nanganganib na makaranas ng pananakit, pang-aabuso, pagbabanta, o sapilitang pagsasama.",
                    "reversed": false
                }
            ]
        },
        {
            "code": "III",
            "title": "Relationship, Marriage\/Union, and Decision-Making",
            "items": [
                9,
                10,
                11,
                12
            ],
            "bands": [
                12,
                16
            ],
            "interpretations": [
                "Limitado ang kakayahang magdesisyon at malayang magpahayag ng kagustuhan.",
                "May kakayahang magdesisyon ngunit may kaunting pressure o limitasyon.",
                "Malaya at pantay na nakapagdedesisyon sa relasyon nang walang pamimilit."
            ],
            "statements": [
                {
                    "number": 9,
                    "text": "Hindi ko malayang naipapahayag ang aking kagustuhan tungkol sa pakikipagrelasyon, pagsasama, o pagpapakasal.",
                    "reversed": true
                },
                {
                    "number": 10,
                    "text": "Nakakapagdesisyon ako tungkol sa aking pakikipag-relasyon o pagsasama nang walang pamimilit o matinding pressure mula sa ibang tao.",
                    "reversed": false
                },
                {
                    "number": 11,
                    "text": "Pakiramdam ko ay pantay ang aking boses at kakayahang magdesisyon sa aking relasyon o pagsasama.",
                    "reversed": false
                },
                {
                    "number": 12,
                    "text": "May mga pagkakataong hindi ko magawa ang gusto ko o hindi ako makapagdesisyon para sa aking sarili dahil sa aking relasyon o pagsasama.",
                    "reversed": false
                }
            ]
        },
        {
            "code": "IV",
            "title": "Health, Sexual and Reproductive Health",
            "items": [
                13,
                14,
                15,
                16
            ],
            "bands": [
                12,
                16
            ],
            "interpretations": [
                "Mataas ang panganib sa kalusugan, nahihirapang mag-access ng libreng health services.",
                "May potensyal ngunit kailangan pang palakasin ang kaalaman at access.",
                "Aktibo at mahusay sa paggamit ng health services at gawi para sa kalusugan."
            ],
            "statements": [
                {
                    "number": 13,
                    "text": "Nakakakuha ako ng tamang impormasyon tungkol sa aking kalusugan, sexual and reproductive health, at mga paraan upang mapangalagaan ang aking sarili.",
                    "reversed": false
                },
                {
                    "number": 14,
                    "text": "Hindi madali para sa akin ang pag-access\/paglapit sa libreng health services at counseling o pakikipag-usap sa propesyonal or eksperto sa mental health na angkop sa aking edad at pangangailangan.",
                    "reversed": true
                },
                {
                    "number": 15,
                    "text": "Alam ko kung saan maaaring humingi ng tulong para sa mga alalahanin tungkol sa aking pisikal, sexual, at reproductive health.",
                    "reversed": false
                },
                {
                    "number": 16,
                    "text": "Nahihiya o natatakot akong humingi ng tulong o magtanong tungkol sa aking kalusugan at sexual and reproductive health.",
                    "reversed": false
                }
            ]
        },
        {
            "code": "V",
            "title": "Education, Skills, and Economic Empowerment",
            "items": [
                17,
                18,
                19,
                20
            ],
            "bands": [
                12,
                16
            ],
            "interpretations": [
                "Posibleng walang malinaw na plano, kinakailangan ng mentoring at suporta.",
                "Nangangailangan ng guidance at access sa opportunities.",
                "May malinaw na plano, suporta, at motibasyon para sa edukasyon at kabuhayan."
            ],
            "statements": [
                {
                    "number": 17,
                    "text": "Kasalukuyan akong nakakapag-aral o may malinaw na pagkakataong maipagpatuloy ang aking edukasyon o pagsasanay.",
                    "reversed": false
                },
                {
                    "number": 18,
                    "text": "Ang aking relasyon, pagsasama, o mga responsibilidad sa bahay ay hindi nakahahadlang sa pagpapatuloy ng aking pag-aaral o pagsasanay.",
                    "reversed": true
                },
                {
                    "number": 19,
                    "text": "May access ako sa mga programa o oportunidad na makatutulong sa akin na magkaroon ng mga kasanayan para sa trabaho o kabuhayan sa hinaharap.",
                    "reversed": false
                },
                {
                    "number": 20,
                    "text": "May sapat akong pinansyal na suporta upang matustusan ang aking mga pangunahing pangangailangan at maipagpatuloy ang aking pag-aaral o iba pang plano para sa hinaharap.",
                    "reversed": false
                }
            ]
        },
        {
            "code": "VI",
